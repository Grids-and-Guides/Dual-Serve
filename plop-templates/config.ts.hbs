import path from "path";
import { FunctionConfig, Trigger } from 'osff-dsl';

const {{camelCase functionName}}Trigger = new Trigger({
  type: "http",
  endpoint: "{{endpoint}}",
  method: "{{method}}",
  responseType: "application/json",
  apiGatewayName: "my-serverless-app-${self.stage}",
  authorizer: ""
});

export const {{camelCase functionName}}Function = new FunctionConfig({
  name: "{{functionName}}-${self.stage}",
  runtime: "lambda.Runtime.NODEJS_22_X",
  handler: "index.handler",
  srcFile: path.resolve(
    process.cwd(),
    "src/api/http/{{functionName}}/{{functionName}}.ts"
  ),
  output: path.resolve(
    process.cwd(),
    "dist/api/http/{{functionName}}/index.js"
  ),
  memory: 256,
  concurrency: 1,
  timeout: 30,
  environmentVariable: {
    cors: "${env.cors}"
  },
  triggers: [{{camelCase functionName}}Trigger]
});