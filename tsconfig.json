{
  "compilerOptions": {
    "target": "es2020",                                  
    "module": "commonjs",                                
    "esModuleInterop": true,                             
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                      
    "skipLibCheck": true,                               
    "rootDir": ".",
    "outDir": "./dist",
    "preserveConstEnums": true,
    "noEmit": false,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "exclude": ["node_modules", "**/*.test.ts", "cdk.out", "builder.ts", "app.ts"],
  "include": ["**/*.ts", "deploy.ts", "app.ts"]
}
